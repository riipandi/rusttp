# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_TRANSPORT=file
LOG_ROTATION=hourly

# ─── Tracing (fastrace) ─────────────────────────────────────────────────────
# Enable span collection. Default: false (max performance).
TRACING_ENABLE=false

# Sampling rate (0.0–1.0). Only applies when TRACING_ENABLE=true.
# 1.0 = trace every request, 0.5 = trace half, 0.0 = trace none.
TRACING_SAMPLING=0.7

# Span reporter mode: unset | console | file | otel
#   unset   — spans collected in ring buffer, silently evicted (zero I/O)
#   console — spans printed to stdout (debugging)
#   file    — spans written to storage/logs/rusttp_trace_*.jsonl
#   otel    — export via OTLP (respects OTEL_EXPORTER_OTLP_ENDPOINT etc.)
TRACING_REPORTER=console

# ─── OpenTelemetry (only when TRACING_REPORTER=otel) ──────────────────────
OTEL_SERVICE_NAME=rusttp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
