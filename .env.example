# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_TRANSPORT=file
LOG_ROTATION=hourly

# ─── Tracing (fastrace) ─────────────────────────────────────────────────────
# Set to "console" to emit fastrace span traces to stderr for debugging.
# When unset, spans are collected but not output — near-zero overhead.
TRACING_REPORTER=console
