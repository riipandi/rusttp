# Address the server listens on (`serve --bind` overrides it).
BIND_ADDR=127.0.0.1:3000

# What the process is for: development, production, or test. Unset means production.
# Storybook is served on /storybook in every mode but production.
APP_MODE=development

# Set to false to leave Storybook out of the build and the binary (`STORYBOOK=false just build`).
# Read at build time; the default is true.
# STORYBOOK=true

# Log level (error, warn, info, debug, trace) or per-module directives, e.g. `info,vixum=debug`.
# Module names print only when debug or trace is on.
LOG_LEVEL=info

# Host ports for the development services in container/compose-dev.yaml.
PGSQL_PORT=5432
REDIS_PORT=6379
