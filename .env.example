# Address the server listens on (`serve --bind` overrides it).
BIND_ADDR=127.0.0.1:3000

# Log filter, see https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html
RUST_LOG=info,memory_serve=warn

# Host ports for the development services in container/compose-dev.yaml.
PGSQL_PORT=5432
REDIS_PORT=6379
