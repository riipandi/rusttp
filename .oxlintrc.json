{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "react", "unicorn", "import", "jsx-a11y", "eslint", "oxc"],
    "options": { "typeAware": true },
    "env": { "browser": true, "builtin": true },
    "categories": { "correctness": "error", "suspicious": "error" },
    "rules": {
        "import/no-cycle": "warn",
        "import/no-unassigned-import": "off",
        "no-console": "off",
        "no-debugger": "warn",
        "no-empty": ["error", { "allowEmptyCatch": true }],
        "no-unused-vars": ["error", { "args": "after-used" }],
        "react/jsx-key": "error",
        "react/no-array-index-key": "error",
        "react/react-in-jsx-scope": "off",
        "react/self-closing-comp": ["error", { "html": true, "component": true }],
        "typescript/consistent-type-definitions": ["error", "interface"],
        "typescript/no-explicit-any": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-misused-promises": "error",
        "typescript/triple-slash-reference": "allow"
    },
    "ignorePatterns": ["**/dist", "**/.tanstack", "**/routes.gen.ts"]
}
