{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "react", "unicorn", "import", "jsx-a11y", "eslint", "oxc"],
    "options": { "typeAware": true },
    "jsPlugins": [{ "name": "paraglide", "specifier": "@inlang/paraglide-js/eslint" }],
    "env": { "browser": true, "builtin": true },
    "categories": { "correctness": "error", "suspicious": "error" },
    "rules": {
        "import/no-cycle": "warn",
        "import/no-unassigned-import": "off",
        "no-console": "off",
        "no-debugger": "warn",
        "no-empty": ["error", { "allowEmptyCatch": true }],
        "no-restricted-imports": [
            "error",
            {
                "patterns": [
                    {
                        "group": ["#/paraglide/messages"],
                        "message": "Read messages through useMessages() (#/libraries/messages) so a language change re-renders the caller."
                    }
                ]
            }
        ],
        "no-unused-vars": ["error", { "args": "after-used" }],
        "paraglide/no-dynamic-message-access": "error",
        "react/jsx-key": "error",
        "react/no-array-index-key": "error",
        "react/react-in-jsx-scope": "off",
        "react/self-closing-comp": ["error", { "html": true, "component": true }],
        "typescript/consistent-type-definitions": ["error", "interface"],
        "typescript/no-explicit-any": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-misused-promises": "error",
        "typescript/triple-slash-reference": "allow"
    },
    "overrides": [
        {
            "files": [
                "packages/webapp/app/libraries/messages.ts",
                "packages/webapp/app/schemas/*.ts"
            ],
            "rules": { "no-restricted-imports": "off" }
        },
        {
            "files": ["packages/uilibs/**"],
            "rules": {
                "jsx-a11y/anchor-has-content": "off",
                "jsx-a11y/click-events-have-key-events": "off",
                "jsx-a11y/control-has-associated-label": "off",
                "jsx-a11y/heading-has-content": "off",
                "jsx-a11y/label-has-associated-control": "off",
                "jsx-a11y/no-noninteractive-element-interactions": "off",
                "jsx-a11y/prefer-tag-over-role": "off",
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["#/**"],
                                "message": "uilibs has no #/ alias: import with a relative path."
                            }
                        ]
                    }
                ],
                "react-hooks/exhaustive-deps": "off",
                "react/exhaustive-effect-dependencies": "off",
                "react/immutability": "off",
                "react/incompatible-library": "off",
                "react/memo-dependencies": "off",
                "react/no-array-index-key": "off",
                "react/no-children-prop": "off",
                "react/no-unstable-nested-components": "off",
                "react/refs": "off",
                "react/static-components": "off"
            }
        }
    ],
    "ignorePatterns": ["**/dist", "**/.tanstack", "**/routes.gen.ts", "**/paraglide"]
}
