        "@dnd-kit/utilities": "^3.2.2",
        "@keyline-icons/react": "^1.8.0",
        "@stylexjs/atoms": "^0.19.1",
        "@stylexjs/stylex": "^0.19.1",
        "@tanstack/charts": "^1.1.0",
        "@tanstack/react-hotkeys": "catalog:",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-table": "^9.2.8",
        "@tanstack/react-virtual": "^3.14.15",
        "country-flag-icons": "^1.6.20",
        "date-fns": "catalog:",
        "react": "catalog:",
        "react-day-picker": "^10.0.2",
        "react-dom": "catalog:",
