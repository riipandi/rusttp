{
    "name": "uilibs",
    "private": true,
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        "./*": [
            "./src/*",
            "./src/*/index.ts",
            "./src/*/index.tsx",
            "./src/*.ts",
            "./src/*.tsx"
        ]
    },
    "scripts": {
        "storybook": "NODE_OPTIONS=--disable-warning=DEP0205 storybook dev -p 6006 --no-open",
        "storybook:build": "STORYBOOK_BUILD=1 NODE_OPTIONS=--disable-warning=DEP0205 storybook build -o ../../apps/server/storybook",
        "storybook:start": "vite preview --outDir ../../apps/server/storybook --port 6006 --host 0.0.0.0 --strictPort",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "check:docs": "node scripts/check-docs.ts",
        "check:docs:test": "node --test scripts/check-docs.test.ts",
        "rebrand": "node scripts/rebrand.ts",
        "typecheck": "tsrs --noEmit --fast"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@keyline-icons/react": "catalog:",
        "@stylexjs/atoms": "catalog:",
        "@stylexjs/stylex": "catalog:",
        "@tanstack/charts": "catalog:",
        "@tanstack/react-router": "catalog:",
        "@tanstack/react-table": "catalog:",
        "@tanstack/react-virtual": "catalog:",
        "country-flag-icons": "^1.6.20",
        "react": "catalog:",
        "react-day-picker": "^10.0.2",
        "react-dom": "catalog:",
        "react-phone-number-input": "^3.4.18",
        "react-resizable-panels": "catalog:"
    },
    "devDependencies": {
        "@github-ui/storybook-addon-performance-panel": "catalog:",
        "@storybook/addon-a11y": "catalog:",
        "@storybook/addon-docs": "catalog:",
        "@storybook/addon-mcp": "catalog:",
        "@storybook/addon-vitest": "catalog:",
        "@storybook/tanstack-react": "catalog:",
        "@tanstack/react-hotkeys": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "date-fns": "catalog:",
        "playwright": "catalog:",
        "plugins": "workspace:*",
        "remark-gfm": "^4.0.1",
        "storybook": "catalog:",
        "tsrs": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
