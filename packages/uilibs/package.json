{
    "name": "uilibs",
    "private": true,
    "type": "module",
    "exports": {
        "./*": [
            "./src/*",
            "./src/*/index.ts",
            "./src/*/index.tsx",
            "./src/*.ts",
            "./src/*.tsx"
        ]
    },
    "scripts": {
        "storybook": "NODE_OPTIONS=--disable-warning=DEP0205 storybook dev -p 6006 --no-open",
        "storybook:build": "NODE_OPTIONS=--disable-warning=DEP0205 storybook build -o .output/storybook",
        "storybook:start": "vite preview --outDir .output/storybook --port 6006 --host 0.0.0.0 --strictPort",
        "test": "vitest run",
        "typecheck": "tsrs --noEmit --fast"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@dnd-kit/core": "^6.3.1",
