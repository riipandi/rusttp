[doc('Remove artifacts (optionally `--all` or `--dry-run`)')]
[group('utility')]
[no-exit-message]
[positional-arguments]
cleanup *args:
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    dry_run=false all=false
    for arg in "$@"; do
        case "$arg" in
            --dry-run) dry_run=true ;;
            --all) all=true ;;
            *) echo "unknown option: $arg (expected --all or --dry-run)" >&2; exit 2 ;;
        esac
    done
    # Everything here is regenerated by `just build` / `just dev` (or `pnpm install` for --all).
    paths=(
        target                                  # cargo
        apps/server/frontend apps/server/emails # the SPA and email builds the server embeds
        packages/webapp/app/routes.gen.ts packages/webapp/.tanstack
        packages/emails/.compiled packages/emails/.rendered
        packages/*/.output                      # Playwright reports
        packages/*/node_modules/.vite           # Vite's dependency cache
        .rumdl_cache tmp temp
    )
    if $all; then paths+=(node_modules packages/*/node_modules); fi
    human() { awk -v kb="$1" 'BEGIN { split("K M G T", u); i = 1; while (kb >= 1024 && i < 4) { kb /= 1024; i++ } printf (i == 1 ? "%d%s" : "%.1f%s"), kb, u[i] }'; }
    status() { printf '{{ BOLD + GREEN }}%12s{{ NORMAL }} %s\n' "$1" "$2"; }
    total=0
    for path in "${paths[@]}"; do
        [[ -e "$path" ]] || continue
        kb=$(du -sk "$path" | cut -f1)
        total=$((total + kb))
        $dry_run || rm -rf "$path"
        status "$($dry_run && echo "Would remove" || echo "Removed")" "$path ($(human "$kb"))"
    done
    if ((total == 0)); then echo "Nothing to clean"; exit 0; fi
    status "$($dry_run && echo "Would free" || echo "Freed")" "$(human "$total")"

[doc('Generate local HTTPS certificates using mkcert')]
[group('utility')]
[no-exit-message]
cert-generate:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v mkcert >/dev/null || { echo "mkcert is not installed (brew install mkcert)" >&2; exit 1; }
    mkdir -p storage/config
    mkcert -key-file storage/config/localhost_key.pem -cert-file storage/config/localhost_crt.pem \
        localhost 127.0.0.1 ::1 host.docker.internal mock-oauth2.localhost localhost.emobix.co.uk
    cp "$(mkcert -CAROOT)/rootCA.pem" storage/config/rootCA.pem

[doc('Build the conformance suite truststore')]
[group('utility')]
[no-exit-message]
cert-conformance:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v keytool >/dev/null || { echo "keytool is not installed (it ships with a JDK)" >&2; exit 1; }
    test -f storage/config/rootCA.pem || { echo "run just cert-generate first" >&2; exit 1; }
    rm -f storage/config/conformance-trust.p12
    keytool -importcert -noprompt -alias mkcert-ca -file storage/config/rootCA.pem \
        -keystore storage/config/conformance-trust.p12 -storetype PKCS12 -storepass changeit

[doc('Trust the mkcert CA on this machine')]
[group('utility')]
[no-exit-message]
cert-trust:
    @mkcert -install
